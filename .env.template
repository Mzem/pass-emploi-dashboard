###----------------------------------- SERVEUR -----------------------------------###
PORT=3100
# URL publique (utilisée pour afficher les URLs de webhook dans le front).
# Si absente, elle est déduite de la requête (Host / X-Forwarded-Proto).
PUBLIC_URL=http://localhost:3100

###----------------------------------- STOCKAGE ----------------------------------###
# Si DATABASE_URL est défini : PostgreSQL (fourni automatiquement par l'addon Scalingo).
# Sinon : SQLite dans DATA_DIR (par défaut ./data).
# DATABASE_URL=postgres://user:password@localhost:5432/dashboard
DATA_DIR=./data
# Durée de conservation des notifications, en jours (purge automatique).
RETENTION_DAYS=30
# Région Scalingo des apps, pour les liens vers le dashboard dans les évènements Scalingo.
SCALINGO_REGION=osc-secnum-fr1

###---------------------------- ACCÈS AU TABLEAU DE BORD -------------------------###
# Basic Auth pour le front et l'API. Si absent, l'accès est libre (dev local uniquement).
DASHBOARD_USER=
DASHBOARD_PASSWORD=

###--------------------------------- WEBHOOKS ------------------------------------###
# Un token secret par webhook. L'URL à donner aux applications émettrices est :
#   POST <PUBLIC_URL>/hooks/<token>
# Si un token est absent, la valeur par défaut "<catégorie>-<env>" est utilisée
# (ex : jobs-prod) : pratique en local, à ne PAS utiliser en production.
HOOK_TOKEN_JOBS_PROD=
HOOK_TOKEN_JOBS_STAGING=
HOOK_TOKEN_ELASTIC_PROD=
HOOK_TOKEN_ELASTIC_STAGING=
HOOK_TOKEN_SCALINGO_PROD=
HOOK_TOKEN_SCALINGO_STAGING=
HOOK_TOKEN_CVE_PROD=
HOOK_TOKEN_CVE_STAGING=
